{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"]
  },
  "include": [
    "src/imports/**/*.js",
    "src/scheduling/**/*.js",
    "src/components/OfficeLayout.jsx",
    "src/pages/AssetImports.jsx",
    "src/pages/EngineerScheduling.jsx"
  ]
}
