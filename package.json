{
  "name": "instafirepilot",
  "version": "1.0.0",
  "private": true,
  "description": "Local consolidation candidate; engineer app, Office Portal and Firebase backend",
  "scripts": {
    "start": "npm --prefix engineer-app run start",
    "android": "npm --prefix engineer-app run android",
    "ios": "npm --prefix engineer-app run ios",
    "web": "npm --prefix engineer-app run web",
    "dev:office": "npm --prefix office-portal run dev",
    "lint": "npm run lint:root && npm run lint:engineer && npm run lint:office",
    "lint:root": "eslint . --no-cache",
    "lint:engineer": "npm --prefix engineer-app run lint",
    "lint:office": "npm --prefix office-portal run lint",
    "typecheck": "tsc --noEmit -p engineer-app/tsconfig.json && tsc --noEmit -p backend/tsconfig.json && npm --prefix office-portal run typecheck",
    "test:unit": "node --test tests/inspections/*.test.mjs tests/catalogue/*.test.mjs tests/fireAlarms/*.test.mjs",
    "test:security": "node tests/firebase/run-emulators.mjs",
    "test:office": "npm --prefix office-portal run test",
    "build:backend": "npm --prefix backend run build",
    "build:office": "npm --prefix office-portal run build"
  },
  "dependencies": {
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "9",
    "eslint-config-expo": "~58.0.4",
    "firebase-tools": "^15.34.2",
    "typescript": "~6.0.3"
  }
}
